# ============================================================================
# SNIPER server environment — copy to server/.env and fill in. Never commit
# server/.env. All secrets below stay server-side (the browser never sees them).
# ============================================================================

# --- Primary database (the CRM core). This repo runs Postgres. Local dev can
# use a local Postgres; production targets a hosted/Supabase Postgres.
# SSL is auto-detected: loopback hosts connect plain, remote hosts use TLS.
# Force with DATABASE_SSL=true|false.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/sniper
# DATABASE_SSL=false

# --- Serverless boot tuning (Vercel) ----------------------------------------
# On Vercel the demo seed (20-30s) is skipped automatically because it exceeds
# the function invocation budget; seed the hosted DB once with `npm run seed`.
# DATABASE_AUTO_SEED=true   # force boot-seeding even on Vercel
# DATABASE_SKIP_SCHEMA=true # skip CREATE-IF-NOT-EXISTS DDL per cold start

# Stateless session-token signing secret. MUST be set to a strong random value
# in any shared/serverless deployment (all instances must share it).
# NEXUS_AUTH_SECRET=change-me

# --- Digitap (provider of the Integration Hub adapters) ---------------------
# Digitap authenticates with HTTP Basic (client_id : client_secret). Pairs are
# issued per environment at onboarding. Note: re-probed 2026-09-04 with
# doc-correct payloads — the supplied pair (07625809) returns HTTP 401 on UAT
# for both pan_basic V1 and V2 (earlier 400s were pre-auth payload gates).
# Confirm the correct UAT pair and PAN Basic enablement with Digitap, then
# click the hub Test button. Other products require enablement + their docs.
DIGITAP_ENV=uat                    # uat | prod
DIGITAP_UAT_CLIENT_ID=
DIGITAP_UAT_CLIENT_SECRET=
DIGITAP_PROD_CLIENT_ID=
DIGITAP_PROD_CLIENT_SECRET=

# --- Supabase provider store (hybrid persistence for integration/compliance) -
# Tables: see supabase/migrations/0001_provider_hub.sql (RLS on, service-role only).
SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # server-only; never ship to the client
